{
  "name": "lawyer-up-v3",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.16"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:property": "vitest run tests/property",
    "test:architecture": "vitest run tests/architecture",
    "test:verify": "vitest run verify",
    "test:idor": "vitest run idor",
    "test:rate-limit": "vitest run rate-limit",
    "test:coverage": "vitest run --coverage",
    "check-all": "npm run lint && npm run typecheck && npm run test && npm run build",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:migrate:remote": "tsx scripts/db-migrate-remote.ts",
    "validate:live": "tsx scripts/validate-live/index.ts",
    "e2e:server": "tsx scripts/e2e-server.ts",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test --grep @a11y",
    "capture:screens": "tsx scripts/capture-screens.ts",
    "security:audit": "npm audit --audit-level=high"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@google/genai": "^2.24.0",
    "@tanstack/react-query": "^5.103.2",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "drizzle-orm": "^0.45.3",
    "lucide-react": "^1.48.0",
    "mammoth": "^1.12.3",
    "motion": "^13.4.3",
    "next": "16.3.6",
    "next-themes": "^0.4.6",
    "openai": "^7.22.0",
    "postgres": "^3.4.9",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-resizable-panels": "^4.13.3",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "unpdf": "^1.8.1",
    "uuidv7": "^1.2.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "fast-check": "^4.10.2",
    "jest-axe": "^11.0.0",
    "jsdom": "^30.1.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.1"
  }
}
