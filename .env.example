# Variable NAMES only — see docs/ARCHITECTURE.md "Env inventory" for scope/notes.
# Never commit real values. Copy to .env and fill in locally.

# --- LLM providers ---
GEMINI_API_KEY=
NVIDIA_API_KEY=
OPENROUTER_API_KEY=
# Optional model overrides (defaults live in src/server/llm/providers.ts)
GEMINI_MODEL=
GEMINI_FALLBACK_MODEL=
GEMMA_MODEL_GOOGLE=
GEMMA_MODEL=
GEMMA_MODEL_NIM=
GEMMA_MODEL_OPENROUTER=

# --- Database (empty = local PGlite in .pglite/; prod = Supavisor pooler URL, port 6543) ---
DATABASE_URL=

# --- Secrets (each ≥32 bytes, never whitespace-only; required in production) ---
GUEST_SESSION_SECRET=
# Verify-only previous secret, set during rotation so live guest sessions survive
GUEST_SESSION_SECRET_PREVIOUS=
RATE_LIMIT_IP_HASH_SECRET=
LOCAL_STORAGE_SIGNING_SECRET=
# "postgres" forces the Postgres/bytea storage adapter; "local" or unset picks the local filesystem
# adapter, except on Vercel, where Postgres is forced regardless (see docs/ARCHITECTURE.md).
STORAGE_BACKEND=
# Dev-only sign-in's own cookie secret; production never reads it — the adapter refuses to construct there.
DEV_SESSION_SECRET=

# --- Rate limits (optional; defaults in src/server/rate-limit/limiter.ts) ---
RATE_LIMIT_PRINCIPAL_PER_MINUTE=
RATE_LIMIT_IP_PER_MINUTE=
RATE_LIMIT_IP_LLM_PER_MINUTE=
RATE_LIMIT_PRINCIPAL_PER_DAY=
RATE_LIMIT_IP_LLM_PER_DAY=
RATE_LIMIT_GEMINI_PER_MINUTE=
RATE_LIMIT_GEMINI_FALLBACK_PER_MINUTE=
RATE_LIMIT_GEMMA_PER_MINUTE=
RATE_LIMIT_GEMMA_GOOGLE_PER_MINUTE=

# --- Active-row caps per principal, for each of documents, comparisons and drafts (optional;
# defaults in src/server/data/documents.ts) ---
MAX_ACTIVE_ROWS_PER_GUEST=
MAX_ACTIVE_ROWS_PER_USER=

# --- Client IP (off Vercel only): how many reverse proxies sit in front of the app. Unset = none
# trusted, and every client shares one conservative rate-limit bucket ---
TRUSTED_PROXY_HOPS=


# --- SUPABASE ---------------------------------------
SUPABASE_DB_PASSWORD=
SUPABASE_PROJECT_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=

SUPABASE_DIRECT_CONNECTION_STRING=
SUPABASE_DIRECT_CONNECTION_HOST=
SUPABASE_DIRECT_CONNECTION_PORT=
SUPABASE_DIRECT_CONNECTION_DATABASE=
SUPABASE_DIRECT_CONNECTION_USER=

SUPABASE_TRANSACTION_POOLER_CONNECTION_STRING=
SUPABASE_TRANSACTION_POOLER_HOST=
SUPABASE_TRANSACTION_POOLER_PORT=
SUPABASE_TRANSACTION_POOLER_DATABASE=
SUPABASE_TRANSACTION_POOLER_USER=

SUPABASE_SESSION_POOLER_CONNECTION_STRING=
SUPABASE_SESSION_POOLER_HOST=
SUPABASE_SESSION_POOLER_PORT=
SUPABASE_SESSION_POOLER_DATABASE=
SUPABASE_SESSION_POOLER_USER=
